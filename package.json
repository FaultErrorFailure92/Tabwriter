{
  "name": "stagecraft",
  "version": "1.0.0",
  "description": "Stagecraft – von der Idee bis zur Bühne: Tab-Editor (GP5-kompatibel), Arrangement, Bühne, Setlists, Gigs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "tauri": "tauri",
    "preview": "vite preview",
    "release": "tauri build --config src-tauri/tauri.release.conf.json",
    "test": "node tests/run.mjs",
    "build:pages": "tsc -p . && vite build --outDir dist/app --emptyOutDir && node -e \"require('fs').cpSync('landing','dist',{recursive:true})\""
  },
  "license": "MIT",
  "dependencies": {
    "@coderline/alphatab": "^1.8.4"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.4",
    "@tauri-apps/cli": "^2.12.1",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0"
  },
  "type": "module",
  "private": "true"
}
