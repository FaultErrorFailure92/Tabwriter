{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "/Volumes/**"
        }
      ]
    },
    "core:menu:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:event:default",
    "core:webview:allow-print",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "core:window:allow-set-theme"
  ]
}